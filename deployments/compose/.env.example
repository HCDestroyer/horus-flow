# Horus Flow — variables del compose de desarrollo (deployments/compose/compose.dev.yaml).
#
# `make up` copia este archivo a deployments/compose/.env si no existe. Edita .env (ignorado
# por Git), nunca este archivo, para cambiar puertos o nombres en tu máquina.
#
# Aquí NO hay secretos: las contraseñas viven en deployments/compose/secrets/*.txt (ignorado
# por Git), las genera scripts/dev-secrets.sh con valores aleatorios y los contenedores las
# leen como archivos en /run/secrets/<nombre> (docs/conventions.md §10).

# --- Proyecto -------------------------------------------------------------------------------
# Prefijo de contenedores, red y volúmenes (horus-dev_pg-data, ...).
COMPOSE_PROJECT_NAME=horus-dev

# Interfaz del host donde se publican los puertos. 127.0.0.1 = solo esta máquina.
HORUS_BIND_ADDR=127.0.0.1

# --- Obligatorias (sin valor por defecto: `make up` falla nombrándolas si faltan) ------------
HORUS_PG_DB=horus
HORUS_PG_USER=horus
HORUS_CH_DB=horus
HORUS_CH_USER=horus

# --- Puertos publicados en el host (cámbialos si están ocupados) ------------------------------
HORUS_PG_PORT=5432
HORUS_CH_HTTP_PORT=8123
HORUS_CH_NATIVE_PORT=9000
HORUS_NATS_PORT=4222
HORUS_NATS_MONITOR_PORT=8222
HORUS_VALKEY_PORT=6379
HORUS_HTTP_PORT=8000
HORUS_TRAEFIK_ADMIN_PORT=8082

# --- Límites ---------------------------------------------------------------------------------
# Descriptores de archivo de ClickHouse (recomendado 262144). Bájalo si `make up` falla con
# "error setting rlimit" porque el host/daemon de Docker tiene un límite menor.
HORUS_CH_NOFILE=262144

# --- Perfil `app` (contenedores propios de la imagen horus; requiere I0-04) -----------------
# Se levantan con `make up COMPOSE_PROFILES=app`.
HORUS_IMAGE=horus:dev
HORUS_LOG_LEVEL=info
HORUS_COLLECTOR_IPFIX_PORT=4739
HORUS_COLLECTOR_V9_PORT=2055
HORUS_APP_ADMIN_PORT=8081
