# Ejemplo del .env que genera scripts/install.sh para compose.prod.yaml (I1-22). NO se usa en
# servidores (el instalador escribe <instalación>/.env con los valores reales); sirve para que la
# CI valide el compose (`docker compose config`) y como referencia. Sin secretos: los secretos son
# archivos en HORUS_SECRETS_DIR.
COMPOSE_PROJECT_NAME=horus
HORUS_IMAGE=horus:local
HORUS_POSTGRES_IMAGE=horus-postgres:18.6-pgbackrest2.59.3
HORUS_CONFIG_DIR=/opt/horus/config
HORUS_SECRETS_DIR=/etc/horus/secrets
HORUS_TLS_DIR=/etc/horus/tls
HORUS_DATA_ROOT=/var/lib/horus
HORUS_STORE_DIR=/var/lib/horus/store
HORUS_PG_DB=horus
HORUS_PG_USER=horus
HORUS_CH_DB=horus
HORUS_CH_USER=horus
HORUS_CH_NOFILE=262144
HORUS_ACCESS_MODE=ip_only
HORUS_TLS_MODE=self_signed
HORUS_PUBLIC_BASE_URL=https://203.0.113.10
HORUS_ACME_EMAIL=
HORUS_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
HORUS_PUBLIC_BIND=0.0.0.0
HORUS_HTTP_PORT=80
HORUS_HTTPS_PORT=443
HORUS_SEED_ADMIN_EMAIL=admin@isp.example
HORUS_WG_HUB_ID=5b0f9a1e-0000-4000-8000-000000000001
HORUS_WG_ENDPOINT=203.0.113.10
HORUS_WG_PORT=51820
HORUS_WG_INTERFACE=wg0
HORUS_WG_HUB_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
HORUS_WG_TUNNEL_CIDRS=10.255.0.0/16
HORUS_WG_SERVICES_CIDR=10.255.0.0/24
HORUS_COLLECTOR_IP=10.255.0.1
HORUS_DOCKER_SUBNET=172.31.250.0/24
HORUS_GRPC_BIND=172.31.250.1
HORUS_TLM_FLOWS_MAX_BYTES=53687091200
HORUS_NATS_MAX_FILE_STORE=71680MB
HORUS_BACKUP_METRICS_PORT=9109
HORUS_RAW_TTL_DAYS=7
HORUS_BACKUP_CH_KEEP_FULL=3
HORUS_SMTP_HOST=
HORUS_SMTP_PORT=587
HORUS_SMTP_FROM=
HORUS_SMTP_USERNAME=
HORUS_SMTP_TLS=starttls
