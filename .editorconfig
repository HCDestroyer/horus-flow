# https://editorconfig.org — conventions.md §4: UTF-8, LF, 2 espacios (Go: tabs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk,go.mod,go.sum}]
indent_style = tab
indent_size = 4

[*.md]
# Dos espacios al final de línea son un salto en Markdown.
trim_trailing_whitespace = false
