{
  "name": "@horus-flow/frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:mocks": "HORUS_UI_MOCKS=1 nuxt dev",
    "build": "nuxt generate",
    "build:mocks": "HORUS_UI_MOCKS=1 nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "node scripts/generate-api.mjs --check && eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.141",
    "@nuxt/ui": "4.11.3",
    "@nuxtjs/i18n": "10.6.0",
    "echarts": "6.1.0",
    "nuxt": "4.6.0",
    "openapi-fetch": "0.17.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-echarts": "8.3.0",
    "vue-router": "5.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.56.1",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
