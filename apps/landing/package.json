{
  "name": "@horus-flow/landing",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.141",
    "@nuxt/ui": "4.11.3",
    "@nuxtjs/i18n": "10.6.0",
    "nodemailer": "10.0.10",
    "nuxt": "4.6.0",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.56.1",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
