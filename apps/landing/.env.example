# Landing de Horus Flow — variables de entorno (README.md › Variables).
# Copia este archivo a .env y rellena lo que corresponda. No lo subas al repositorio.
# Los secretos van como archivos (*_FILE), p. ej. con los secrets de compose.example.yaml.

# URL pública canónica, sin barra final (canonical, hreflang, Open Graph, JSON-LD, sitemap).
NUXT_PUBLIC_SITE_URL=https://horusflow.kns.gt

# --- Datos y panel -------------------------------------------------------------------------------
# Carpeta de la base de datos SQLite (en Docker, el volumen /data).
DATA_DIR=/data
# Clave de cifrado de las credenciales de PayPal: 32 bytes en base64 o hex.
#   openssl rand -base64 32 > secrets/data.key
DATA_KEY_FILE=/run/secrets/data_key
# Primer administrador (solo si aún no hay ninguno). Dará de alta su TOTP en el primer acceso.
ADMIN_EMAIL=info@kns.gt
ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# Solo desarrollo por HTTP en una IP que no sea localhost: cookie de sesión sin Secure ni __Host-.
# Se ignora en producción.
# ADMIN_COOKIE_INSECURE=1

# --- Correo (SMTP) -----------------------------------------------------------------------------
# Servidor de kns.gt aún por definir. Sin SMTP_HOST las solicitudes se guardan igualmente en la
# base de datos (y se ven en /admin), pero no se envían correos.
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo (465); con 587 se usa STARTTLS.
SMTP_SECURE=false
SMTP_USER=
# Contraseña SMTP como archivo (o SMTP_PASS directamente, no recomendado).
SMTP_PASS_FILE=/run/secrets/smtp_pass
# Remitente: debe estar autorizado por el SPF/DKIM de kns.gt (README.md › Correo).
MAIL_FROM="Horus Flow <info@kns.gt>"
# Destino de los avisos (solicitudes y pagos).
SALES_EMAIL=info@kns.gt
# Correo de confirmación al cliente (true/false).
MAIL_CONFIRM_CUSTOMER=true
# smtp | file | log. Por defecto: smtp si hay SMTP_HOST, si no log. "file" guarda cada mensaje
# como JSON en MAIL_OUTBOX_DIR (SMTP simulado para desarrollo y e2e).
# MAIL_TRANSPORT=
# MAIL_OUTBOX_DIR=.outbox

# --- CRM (opcional) ----------------------------------------------------------------------------
LEADS_WEBHOOK_URL=
# Firma HMAC-SHA256 del cuerpo en la cabecera X-Horus-Signature (sha256=<hex>).
LEADS_WEBHOOK_SECRET_FILE=

# --- Antispam y proxy --------------------------------------------------------------------------
# IPs o CIDR de los proxies de confianza (Nginx Proxy Manager, Docker): solo de ellos se acepta
# X-Forwarded-For. Vacío = se usa la IP de la conexión.
TRUSTED_PROXIES=
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=600
FORM_MIN_FILL_SECONDS=3

# --- Pagos -----------------------------------------------------------------------------------------
# PayPal, link Neo y transferencia se configuran en /admin › Pagos (credenciales cifradas en la
# base de datos). Solo pruebas, nunca en producción: API de un PayPal simulado.
# PAYPAL_API_BASE=http://127.0.0.1:4176

# Entornos de pruebas: no indexar.
# ROBOTS_DISALLOW_ALL=1
