# docker.service de los binarios estáticos (TEST_MODE=sandbox de make test-install-debian).
[Unit]
Description=Docker Engine (binarios estáticos de prueba)
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
ExecStart=/usr/bin/dockerd --iptables=false --ip6tables=false
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=120
Restart=always
Delegate=yes
KillMode=process
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
