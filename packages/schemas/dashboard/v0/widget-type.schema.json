{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.horus-flow.local/dashboard/v0/widget-type.schema.json",
  "title": "WidgetType",
  "description": "Entrada del catálogo autoritativo de tipos de widget (C9, mitad servidor; api.md §2.11, frontend.md §6.2–§6.3). La sirve GET /widget-types desde widget-types.json.",
  "type": "object",
  "required": ["type", "title", "description", "category", "config_schema", "required_permission", "data_endpoint_kind", "realtime_topic", "contains_personal_data", "kiosk_allowed", "sizes", "increment"],
  "properties": {
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string", "maxLength": 60 },
    "description": { "type": "string", "maxLength": 300, "description": "Empieza por verbo ('Muestra…')." },
    "category": { "type": "string", "enum": ["traffic", "customers", "security", "infrastructure", "platform", "layout"] },
    "config_schema": { "type": "object", "description": "JSON Schema (2020-12) de la config del widget; el servidor valida cada config guardada." },
    "required_permission": { "type": "string", "description": "Permiso que necesita quien mira (usuario). Los kioscos se rigen por kiosk_allowed + dashboards asignados." },
    "additional_permissions": { "type": "array", "items": { "type": "string" } },
    "data_endpoint_kind": { "type": "string", "enum": ["state", "series", "table", "none"] },
    "realtime_topic": { "type": ["string", "null"], "description": "Topic WebSocket (C6) que actualiza el widget, o null si solo REST." },
    "contains_personal_data": { "type": "boolean", "description": "true ⇒ IPs de clientes solo con customers.read; en kiosco enmascaradas salvo show_personal_data." },
    "kiosk_allowed": { "type": "boolean" },
    "sizes": {
      "type": "object",
      "required": ["allowed", "default"],
      "properties": {
        "allowed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Size" } },
        "default": { "$ref": "#/$defs/Size" }
      },
      "additionalProperties": false
    },
    "increment": { "type": "string", "enum": ["I1", "I2", "I3", "I4"] },
    "version": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "Size": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 12 },
        "h": { "type": "integer", "minimum": 1, "maximum": 12 }
      },
      "additionalProperties": false
    }
  }
}
