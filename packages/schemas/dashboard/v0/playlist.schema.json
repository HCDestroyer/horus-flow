{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.horus-flow.local/dashboard/v0/playlist.schema.json",
  "title": "Playlist",
  "description": "Lista de reproducción de dashboards para kioscos (C9; frontend.md §7.5). Duración por defecto 30 s, mínimo 10 s.",
  "type": "object",
  "required": ["id", "tenant_id", "version", "name", "items", "transition", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "maxLength": 80 },
    "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/PlaylistItem" } },
    "transition": { "type": "string", "enum": ["fade", "none"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "PlaylistItem": {
      "type": "object",
      "required": ["dashboard_id", "duration_seconds"],
      "properties": {
        "dashboard_id": { "type": "string", "format": "uuid" },
        "duration_seconds": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 30 },
        "variables": {
          "type": "object",
          "properties": { "site_id": { "type": ["string", "null"], "format": "uuid" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "PlaylistInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/PlaylistItem" } },
        "transition": { "type": "string", "enum": ["fade", "none"], "default": "fade" }
      },
      "additionalProperties": false
    }
  }
}
