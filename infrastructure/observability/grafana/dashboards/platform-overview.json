        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{job=\"horus\", code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_total{job=\"horus\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
