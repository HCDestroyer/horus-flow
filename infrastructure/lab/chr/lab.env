# Laboratorio MikroTik CHR — valores por defecto (historia I0-11).
# scripts/lab/lab.sh lee este archivo; cualquier variable se puede sobrescribir en el entorno
# (p. ej. `make lab-up ROS=7.19.4 LAB_ACCEL=tcg`). Aquí NO hay secretos: las contraseñas del
# laboratorio se generan en $LAB_STATE_DIR/secrets.env (ignorado por Git).

# --- RouterOS (D15: solo 7.x, mínimo 7.12; probar también la última long-term) --------------
ROS=${ROS:-7.12}
CHR_BASE_URL=${CHR_BASE_URL:-https://download.mikrotik.com/routeros}
CHR_CACHE_DIR=${CHR_CACHE_DIR:-$HOME/.cache/horus-lab/chr}

# --- Máquina virtual -------------------------------------------------------------------------
# kvm (por defecto; falla con un mensaje claro si no hay /dev/kvm) o tcg (emulación, muy lenta).
LAB_ACCEL=${LAB_ACCEL:-kvm}
LAB_VM_MEM=${LAB_VM_MEM:-512}
LAB_VM_CPUS=${LAB_VM_CPUS:-2}
LAB_BOOT_TIMEOUT=${LAB_BOOT_TIMEOUT:-180}

# Gestión por la NIC 1 (ether1, QEMU user-net con DHCP): reenvíos en el loopback del host.
LAB_REST_PORT=${LAB_REST_PORT:-18080}     # -> CHR :80  (REST por HTTP, solo admin del lab)
LAB_HTTPS_PORT=${LAB_HTTPS_PORT:-18443}   # -> CHR :443 (www-ssl, para probar "fuera del túnel")
LAB_SSH_PORT=${LAB_SSH_PORT:-12222}       # -> CHR :22
LAB_FILE_PORT=${LAB_FILE_PORT:-18099}     # servidor temporal del host (CHR lo ve en 10.0.2.2)

# --- Red del laboratorio (vendors/mikrotik.md §8.2) ------------------------------------------
LAB_PREFIX=${LAB_PREFIX:-hlab}            # prefijo de bridges, taps y netns
LAB_WAN_NET=${LAB_WAN_NET:-198.18.0}      # /24 de "internet" (RFC 2544, nunca enrutable)
LAB_WAN_HOST_IP=${LAB_WAN_HOST_IP:-198.18.0.1}     # host = endpoint del hub WireGuard
LAB_WAN_CHR_IP=${LAB_WAN_CHR_IP:-198.18.0.2}       # ether2-wan del CHR (NAT masquerade)
LAB_INET_IP=${LAB_INET_IP:-198.18.0.10}            # internet-sim (HTTP, SMTP, "C2", sumidero)
LAB_LAN_NET=${LAB_LAN_NET:-10.20.0}       # /24 de clientes detrás del NAT (D12)
LAB_LAN_GW=${LAB_LAN_GW:-10.20.0.1}       # ether3-lan del CHR
LAB_CLIENTS=${LAB_CLIENTS:-a b c}         # netns ${LAB_PREFIX}-cli-<x> con .11, .12, .13

# --- Túnel WireGuard hacia el "hub" de Horus (D16) y destino IPFIX ---------------------------
# El hub es una interfaz WireGuard del host (${LAB_PREFIX}-wg) que hace de despliegue de Horus.
LAB_WG_PORT=${LAB_WG_PORT:-51820}
LAB_SERVICES_CIDR=${LAB_SERVICES_CIDR:-10.255.0.0/24}
LAB_HUB_IP=${LAB_HUB_IP:-10.255.0.1}      # <HORUS_COLLECTOR_IP>: el IPFIX llega aquí, :4739/udp
LAB_ROUTER_WG_IP=${LAB_ROUTER_WG_IP:-10.255.3.17}
LAB_ROUTER_NAME=${LAB_ROUTER_NAME:-horus-lab-chr}
LAB_NTP_SERVER=${LAB_NTP_SERVER:-pool.ntp.org}
LAB_IPFIX_PORT=${LAB_IPFIX_PORT:-4739}    # fijo en el script de onboarding (§7)

# Estado local (claves, discos, pids, logs). Ignorado por Git.
LAB_STATE_DIR=${LAB_STATE_DIR:-.lab}
