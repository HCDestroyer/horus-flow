# Rutas de PRODUCCIÓN — modo ip_only (D19): sin dominio, certificado autogenerado por
# scripts/install.sh para la IP del servidor (SAN IP:@HORUS_HOST@). La huella SHA-256 se
# muestra al instalar y en `install.sh --check`, y wireguard la incluye en el script RouterOS
# (HORUS_PUBLIC_TLS_CERT_FILE) para no usar nunca check-certificate=no. Sin HSTS: el navegador
# avisará del certificado no emitido por una CA pública hasta que la persona lo acepte.

http:
  routers:
    horus-http:
      entryPoints: [web]
      rule: "PathPrefix(`/`)"
      middlewares: [https-redirect]
      service: noop@internal
    horus-api:
      entryPoints: [websecure]
      rule: "PathPrefix(`/api`) || PathPrefix(`/ws`)"
      middlewares: [security-headers, api-ratelimit]
      service: horus-gateway
      tls: {}
    # Interfaz web (horus-web): todo lo demás, con prioridad baja para que /api y /ws vayan
    # siempre a horus-app.
    horus-web:
      entryPoints: [websecure]
      rule: "PathPrefix(`/`)"
      priority: 1
      service: horus-web
      tls: {}

  middlewares:
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true
    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        referrerPolicy: no-referrer
        customResponseHeaders:
          Server: ""
    api-ratelimit:
      rateLimit:
        average: 50
        burst: 100

  services:
    horus-gateway:
      loadBalancer:
        servers:
          - url: "http://horus-app:8080"
    # La SPA pone sus propias cabeceras de seguridad y CSP (apps/frontend/scripts/serve-static.mjs).
    horus-web:
      loadBalancer:
        servers:
          - url: "http://horus-web:8081"

tls:
  options:
    default:
      minVersion: VersionTLS12
  stores:
    default:
      defaultCertificate:
        certFile: /etc/traefik/tls/public.crt
        keyFile: /etc/traefik/tls/public.key
